{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/generated/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@nestjs/common",
                "importNames": ["Logger"],
                "message": "ADR 0006: inject the shared logger with @InjectPinoLogger(<Class>.name) from nestjs-pino."
              }
            ]
          }
        ]
      }
    }
  ]
}
