# Copy to .env (git-ignored). The values match compose.yaml's local-only
# defaults. For an existing PostgreSQL instance, point the URLs at it instead.

# Application and `prisma migrate` connection.
DATABASE_URL=postgresql://collinson:collinson@localhost:5432/collinson

# Integration and E2E tests connect here to CREATE and DROP their own per-run
# database (collinson_test_*). The role needs the CREATEDB privilege.
TEST_DATABASE_ADMIN_URL=postgresql://collinson:collinson@localhost:5432/postgres

# HTTP port for the GraphQL endpoint (default 3000).
PORT=3000

# Log level for the JSON logs on stdout: fatal, error, warn, info (default),
# debug, trace or silent. Tests ignore it: they run silent unless TEST_LOG_LEVEL
# is set for the run.
# LOG_LEVEL=info

# GraphQL introspection: true or false. When unset it is on, except when
# NODE_ENV=production. The integration and E2E tests turn it on, except the
# E2E spec that checks the production default.
# GRAPHQL_INTROSPECTION=true

# Optional Compose overrides; keep them in step with the URLs above.
# POSTGRES_USER=collinson
# POSTGRES_PASSWORD=collinson
# POSTGRES_DB=collinson
# POSTGRES_PORT=5432
